{
  "manifest_version": 3,
  "name": "مساعد الربط المدرسي الموحد (نور وحضوري)",
  "version": "2.0",
  "description": "إضافة متصفح ذكية تسحب البيانات وتتنقل بين الصفحات تلقائياً بضغطة زر واحدة لتصديرها كملفات إكسل",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.moe.gov.sa/*",
        "*://noor.moe.gov.sa/*",
        "*://*.hudoori.gov.sa/*",
        "*://hudoori.moe.gov.sa/*"
      ],
      "js": ["content.js"]
    }
  ]
}
