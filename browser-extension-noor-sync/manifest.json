{
  "manifest_version": 3,
  "name": "مساعد مزامنة الغياب من نور",
  "version": "3.0.0",
  "description": "ينقل غياب الطلاب من صفحة نور المفتوحة إلى قسم الغياب والمواظبة في المنصة بعد المعاينة.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://noor.moe.gov.sa/*",
    "https://*.noor.moe.gov.sa/*",
    "https://shomar1434-jpg.github.io/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_icon": "icon.png"},
  "content_scripts": [
    {"matches": ["https://noor.moe.gov.sa/*", "https://*.noor.moe.gov.sa/*"], "js": ["content.js"]},
    {"matches": ["https://shomar1434-jpg.github.io/*"], "js": ["platform-bridge.js"]}
  ]
}
